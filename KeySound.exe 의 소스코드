// ============================================================
// FILE PICKER
// ============================================================

static std::wstring SelectAudioFile()
{
    OPENFILENAMEW dialog{};

    wchar_t filename[MAX_PATH]{};

    dialog.lStructSize = sizeof(dialog);

    dialog.lpstrFilter =
        L"Audio Files (*.mp3;*.wav)\0"
        L"*.mp3;*.wav\0"
        L"All Files (*.*)\0"
        L"*.*\0";

    dialog.lpstrFile = filename;
    dialog.nMaxFile = MAX_PATH;

    dialog.Flags =
        OFN_FILEMUSTEXIST |
        OFN_PATHMUSTEXIST;

    if (GetOpenFileNameW(&dialog))
    {
        return std::wstring(filename);
    }

    return L"";
}


// ============================================================
// DECODE AUDIO
// ============================================================

static HRESULT DecodeAudio(
    const std::wstring& filename,
    AudioData& output)
{
    output = {};

    ComPtr<IMFSourceReader> reader;

    HRESULT hr =
        MFCreateSourceReaderFromURL(
            filename.c_str(),
            nullptr,
            &reader
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"[Decode] MFCreateSourceReaderFromURL failed\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        return hr;
    }


    // ========================================================
    // 모든 스트림 비활성화
    // ========================================================

    hr =
        reader->SetStreamSelection(
            MF_SOURCE_READER_ALL_STREAMS,
            FALSE
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"[Decode] SetStreamSelection(ALL) failed\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        return hr;
    }


    // ========================================================
    // 오디오 스트림 활성화
    // ========================================================

    hr =
        reader->SetStreamSelection(
            MF_SOURCE_READER_FIRST_AUDIO_STREAM,
            TRUE
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"[Decode] SetStreamSelection(AUDIO) failed\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        return hr;
    }


    // ========================================================
    // 출력 Media Type
    // ========================================================

    ComPtr<IMFMediaType> requestedType;

    hr =
        MFCreateMediaType(
            &requestedType
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"[Decode] MFCreateMediaType failed\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        return hr;
    }


    hr =
        requestedType->SetGUID(
            MF_MT_MAJOR_TYPE,
            MFMediaType_Audio
        );

    if (FAILED(hr))
        return hr;


    hr =
        requestedType->SetGUID(
            MF_MT_SUBTYPE,
            MFAudioFormat_Float
        );

    if (FAILED(hr))
        return hr;


    hr =
        requestedType->SetUINT32(
            MF_MT_AUDIO_SAMPLES_PER_SECOND,
            OUTPUT_SAMPLE_RATE
        );

    if (FAILED(hr))
        return hr;


    hr =
        requestedType->SetUINT32(
            MF_MT_AUDIO_NUM_CHANNELS,
            OUTPUT_CHANNELS
        );

    if (FAILED(hr))
        return hr;


    // ========================================================
    // Media Type 적용
    // ========================================================

    hr =
        reader->SetCurrentMediaType(
            MF_SOURCE_READER_FIRST_AUDIO_STREAM,
            nullptr,
            requestedType.Get()
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"[Decode] SetCurrentMediaType failed\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        return hr;
    }


    // ========================================================
    // 실제 Media Type
    // ========================================================

    ComPtr<IMFMediaType> actualType;

    hr =
        reader->GetCurrentMediaType(
            MF_SOURCE_READER_FIRST_AUDIO_STREAM,
            &actualType
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"[Decode] GetCurrentMediaType failed\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        return hr;
    }


    // ========================================================
    // 실제 형식 확인
    // ========================================================

    UINT32 sampleRate = 0;
    UINT32 channels = 0;
    UINT32 bits = 0;

    hr =
        actualType->GetUINT32(
            MF_MT_AUDIO_SAMPLES_PER_SECOND,
            &sampleRate
        );

    if (FAILED(hr))
        return hr;


    hr =
        actualType->GetUINT32(
            MF_MT_AUDIO_NUM_CHANNELS,
            &channels
        );

    if (FAILED(hr))
        return hr;


    hr =
        actualType->GetUINT32(
            MF_MT_AUDIO_BITS_PER_SAMPLE,
            &bits
        );

    if (FAILED(hr))
        return hr;


    GUID subtype{};

    hr =
        actualType->GetGUID(
            MF_MT_SUBTYPE,
            &subtype
        );

    if (FAILED(hr))
        return hr;


    if (subtype != MFAudioFormat_Float)
    {
        std::wcerr
            << L"[Decode] Output format is not FLOAT.\n";

        return E_FAIL;
    }


    if (
        sampleRate == 0 ||
        channels == 0 ||
        bits != 32
        )
    {
        std::wcerr
            << L"[Decode] Invalid audio format.\n"
            << L"Sample Rate = "
            << std::dec
            << sampleRate
            << L"\n"
            << L"Channels = "
            << channels
            << L"\n"
            << L"Bits = "
            << bits
            << L"\n";

        return E_FAIL;
    }


    // ========================================================
    // XAudio2 WAVEFORMATEX
    // ========================================================

    output.format = {};

    output.format.wFormatTag =
        WAVE_FORMAT_IEEE_FLOAT;

    output.format.nChannels =
        static_cast<WORD>(channels);

    output.format.nSamplesPerSec =
        sampleRate;

    output.format.wBitsPerSample =
        32;

    output.format.nBlockAlign =
        static_cast<WORD>(
            channels * sizeof(float)
            );

    output.format.nAvgBytesPerSec =
        sampleRate *
        output.format.nBlockAlign;

    output.format.cbSize = 0;


    // ========================================================
    // PCM 읽기
    // ========================================================

    while (true)
    {
        DWORD flags = 0;

        ComPtr<IMFSample> sample;

        hr =
            reader->ReadSample(
                MF_SOURCE_READER_FIRST_AUDIO_STREAM,
                0,
                nullptr,
                &flags,
                nullptr,
                &sample
            );

        if (FAILED(hr))
        {
            std::wcerr
                << L"[Decode] ReadSample failed\n"
                << L"HRESULT = 0x"
                << std::hex
                << static_cast<unsigned long>(hr)
                << L"\n";

            return hr;
        }


        // ====================================================
        // EOF
        // ====================================================

        if (flags & MF_SOURCE_READERF_ENDOFSTREAM)
        {
            break;
        }


        if (!sample)
        {
            continue;
        }


        // ====================================================
        // Buffer
        // ====================================================

        ComPtr<IMFMediaBuffer> buffer;

        hr =
            sample->ConvertToContiguousBuffer(
                &buffer
            );

        if (FAILED(hr))
        {
            std::wcerr
                << L"[Decode] ConvertToContiguousBuffer failed\n"
                << L"HRESULT = 0x"
                << std::hex
                << static_cast<unsigned long>(hr)
                << L"\n";

            return hr;
        }


        BYTE* data = nullptr;
        DWORD dataSize = 0;


        hr =
            buffer->Lock(
                &data,
                nullptr,
                &dataSize
            );

        if (FAILED(hr))
        {
            std::wcerr
                << L"[Decode] Buffer Lock failed\n"
                << L"HRESULT = 0x"
                << std::hex
                << static_cast<unsigned long>(hr)
                << L"\n";

            return hr;
        }


        if (
            data != nullptr &&
            dataSize > 0
            )
        {
            const size_t oldSize =
                output.pcm.size();

            output.pcm.resize(
                oldSize +
                static_cast<size_t>(dataSize)
            );

            std::memcpy(
                output.pcm.data() + oldSize,
                data,
                dataSize
            );
        }


        buffer->Unlock();
    }


    // ========================================================
    // 결과 확인
    // ========================================================

    if (output.pcm.empty())
    {
        std::wcerr
            << L"[Decode] PCM data is empty.\n";

        return E_FAIL;
    }


    if (output.pcm.size() > 0xFFFFFFFFULL)
    {
        std::wcerr
            << L"[Decode] PCM data is too large.\n";

        return E_FAIL;
    }


    // ========================================================
    // 성공
    // ========================================================

    std::wcout
        << L"\n"
        << L"----------------------------------------\n"
        << L"             DECODE SUCCESS\n"
        << L"----------------------------------------\n"
        << L"Sample Rate : "
        << std::dec
        << sampleRate
        << L" Hz\n"
        << L"Channels    : "
        << channels
        << L"\n"
        << L"Bits        : "
        << bits
        << L"\n"
        << L"PCM Size    : "
        << output.pcm.size()
        << L" bytes\n"
        << L"----------------------------------------\n\n";

    return S_OK;
}


// ============================================================
// CREATE VOICE POOL
// ============================================================

static bool CreateVoicePool()
{
    g_voicePool.reserve(VOICE_COUNT);

    for (
        uint32_t i = 0;
        i < VOICE_COUNT;
        ++i
        )
    {
        IXAudio2SourceVoice* voice = nullptr;

        HRESULT hr =
            g_xaudio->CreateSourceVoice(
                &voice,
                &g_audio.format,
                0,
                XAUDIO2_DEFAULT_FREQ_RATIO,
                nullptr
            );

        if (FAILED(hr))
        {
            std::wcerr
                << L"CreateSourceVoice failed: 0x"
                << std::hex
                << static_cast<unsigned long>(hr)
                << L"\n";

            return false;
        }

        g_voicePool.push_back(voice);
    }

    return true;
}


// ============================================================
// DESTROY VOICE POOL
// ============================================================

static void DestroyVoicePool()
{
    for (
        IXAudio2SourceVoice* voice :
        g_voicePool
        )
    {
        if (voice)
        {
            voice->DestroyVoice();
        }
    }

    g_voicePool.clear();
}


// ============================================================
// FIND VOICE
// ============================================================

static IXAudio2SourceVoice* FindVoice()
{
    const uint32_t count =
        static_cast<uint32_t>(
            g_voicePool.size()
            );

    if (count == 0)
    {
        return nullptr;
    }


    const uint32_t start =
        g_voiceIndex.load(
            std::memory_order_relaxed
        );


    for (
        uint32_t i = 0;
        i < count;
        ++i
        )
    {
        const uint32_t index =
            (start + i) % count;

        IXAudio2SourceVoice* voice =
            g_voicePool[index];

        XAUDIO2_VOICE_STATE state{};

        voice->GetState(
            &state,
            XAUDIO2_VOICE_NOSAMPLESPLAYED
        );

        if (state.BuffersQueued == 0)
        {
            g_voiceIndex.store(
                (index + 1) % count,
                std::memory_order_relaxed
            );

            return voice;
        }
    }


    // ========================================================
    // 모두 사용 중이면 하나 재사용
    // ========================================================

    const uint32_t index =
        g_voiceIndex.fetch_add(
            1,
            std::memory_order_relaxed
        ) % count;

    return g_voicePool[index];
}


// ============================================================
// PLAY SOUND
// ============================================================

static void PlaySoundNow()
{
    if (
        !g_running.load(
            std::memory_order_relaxed
        )
        )
    {
        return;
    }


    if (
        g_voicePool.empty() ||
        g_audio.pcm.empty()
        )
    {
        return;
    }


    IXAudio2SourceVoice* voice =
        FindVoice();

    if (!voice)
    {
        return;
    }


    XAUDIO2_VOICE_STATE state{};

    voice->GetState(
        &state,
        XAUDIO2_VOICE_NOSAMPLESPLAYED
    );


    if (state.BuffersQueued != 0)
    {
        voice->Stop(0);
        voice->FlushSourceBuffers();
    }


    XAUDIO2_BUFFER buffer{};

    buffer.AudioBytes =
        static_cast<UINT32>(
            g_audio.pcm.size()
            );

    buffer.pAudioData =
        g_audio.pcm.data();

    buffer.Flags =
        XAUDIO2_END_OF_STREAM;


    HRESULT hr =
        voice->SubmitSourceBuffer(
            &buffer
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"SubmitSourceBuffer failed: 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        return;
    }


    hr =
        voice->Start(0);

    if (FAILED(hr))
    {
        std::wcerr
            << L"SourceVoice Start failed: 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";
    }
}


// ============================================================
// WINDOW PROCEDURE
// ============================================================

static LRESULT CALLBACK WindowProc(
    HWND hwnd,
    UINT message,
    WPARAM wParam,
    LPARAM lParam)
{
    // ========================================================
    // CLOSE
    // ========================================================

    if (message == WM_CLOSE)
    {
        g_running.store(
            false,
            std::memory_order_relaxed
        );

        DestroyWindow(hwnd);

        return 0;
    }


    // ========================================================
    // RAW INPUT
    // ========================================================

    if (message == WM_INPUT)
    {
        if (
            !g_running.load(
                std::memory_order_relaxed
            )
            )
        {
            return 0;
        }


        BYTE buffer[RAW_INPUT_BUFFER_SIZE];

        UINT size =
            sizeof(buffer);


        UINT result =
            GetRawInputData(
                reinterpret_cast<HRAWINPUT>(lParam),
                RID_INPUT,
                buffer,
                &size,
                sizeof(RAWINPUTHEADER)
            );


        if (
            result == static_cast<UINT>(-1) ||
            result == 0
            )
        {
            return 0;
        }


        RAWINPUT* raw =
            reinterpret_cast<RAWINPUT*>(
                buffer
                );


        // ====================================================
        // MOUSE
        // ====================================================

        if (raw->header.dwType == RIM_TYPEMOUSE)
        {
            const RAWMOUSE& mouse =
                raw->data.mouse;


            const USHORT flags =
                mouse.usButtonFlags;


            if (flags & RI_MOUSE_LEFT_BUTTON_DOWN)
            {
                PlaySoundNow();
            }


            if (flags & RI_MOUSE_RIGHT_BUTTON_DOWN)
            {
                PlaySoundNow();
            }


            if (flags & RI_MOUSE_MIDDLE_BUTTON_DOWN)
            {
                PlaySoundNow();
            }


            if (flags & RI_MOUSE_BUTTON_4_DOWN)
            {
                PlaySoundNow();
            }


            if (flags & RI_MOUSE_BUTTON_5_DOWN)
            {
                PlaySoundNow();
            }


            return 0;
        }


        // ====================================================
        // KEYBOARD
        // ====================================================

        if (raw->header.dwType == RIM_TYPEKEYBOARD)
        {
            const RAWKEYBOARD& keyboard =
                raw->data.keyboard;


            UINT vk =
                keyboard.VKey;


            // --------------------------------------------
            // KEY UP
            // --------------------------------------------

            if (
                keyboard.Flags &
                RI_KEY_BREAK
                )
            {
                if (vk < 256)
                {
                    g_keyDown[vk] = false;
                }

                return 0;
            }


            // --------------------------------------------
            // KEY DOWN
            // --------------------------------------------

            if (vk >= 256)
            {
                return 0;
            }


            // =================================================
            // ESC = EXIT
            // =================================================
        if (vk == VK_ESCAPE)
        {
            // 정적(static) 변수를 사용하여 함수가 끝나도 값과 시간을 유지합니다.
            static int escCount = 0;
            static ULONGLONG lastEscTime = 0;

            ULONGLONG currentTime = GetTickCount64(); // 현재 시간을 밀리초(ms) 단위로 가져옴

            // 이전 입력으로부터 2000밀리초(2초)가 지났다면 카운트를 1로 초기화
            if (currentTime - lastEscTime > 2000)
            {
                escCount = 1;
            }
            else
            {
                escCount++; // 2초 이내에 다시 눌렸다면 카운트 증가
            }

            lastEscTime = currentTime; // 마지막으로 누른 시간 업데이트

            // 3번 연속으로 눌렸을 때만 종료 프로세스 실행
            if (escCount >= 3)
            {
                g_running.store(
                    false,
                    std::memory_order_relaxed
                );

                PostMessageW(
                    hwnd,
                    WM_CLOSE,
                    0,
                    0
                );

                escCount = 0; // 카운트 초기화
                return 0;
            }

            return 0; // 3번 미만으로 눌렸을 때는 종료하지 않고 리턴
        }


            // --------------------------------------------
            // 자동 반복 무시
            // --------------------------------------------

            if (g_keyDown[vk])
            {
                return 0;
            }


            g_keyDown[vk] = true;


            // --------------------------------------------
            // KEY SOUND
            // --------------------------------------------

            PlaySoundNow();

            return 0;
        }


        return 0;
    }


    // ========================================================
    // DESTROY
    // ========================================================

    if (message == WM_DESTROY)
    {
        g_running.store(
            false,
            std::memory_order_relaxed
        );

        PostQuitMessage(0);

        return 0;
    }


    return DefWindowProcW(
        hwnd,
        message,
        wParam,
        lParam
    );
}


// ============================================================
// WinMain
// ============================================================

int WINAPI WinMain(
    HINSTANCE instance,
    HINSTANCE,
    LPSTR,
    int)
{
    std::wcout
        << L"========================================\n"
        << L"                 KeySound\n"
        << L"        Keyboard + Mouse Sound\n"
        << L"========================================\n\n";


    // ========================================================
    // COM
    // ========================================================

    HRESULT hr =
        CoInitializeEx(
            nullptr,
            COINIT_MULTITHREADED
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"COM initialization failed.\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        return 1;
    }


    // ========================================================
    // MEDIA FOUNDATION
    // ========================================================

    hr =
        MFStartup(
            MF_VERSION,
            MFSTARTUP_FULL
        );

    if (FAILED(hr))
    {
        std::wcerr
            << L"Media Foundation initialization failed.\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        CoUninitialize();

        return 1;
    }


    // ========================================================
    // FILE SELECT
    // ========================================================

    std::wcout
        << L"Select an MP3 or WAV file...\n";


    std::wstring filename =
        SelectAudioFile();


    if (filename.empty())
    {
        std::wcout
            << L"No file selected.\n";

        MFShutdown();
        CoUninitialize();

        return 0;
    }


    std::wcout
        << L"\nSelected:\n"
        << filename
        << L"\n\n";


    // ========================================================
    // DECODE
    // ========================================================

    std::wcout
        << L"Decoding audio...\n";


    hr =
        DecodeAudio(
            filename,
            g_audio
        );


    if (FAILED(hr))
    {
        std::wcerr
            << L"\n========================================\n"
            << L"          AUDIO DECODING FAILED\n"
            << L"========================================\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n"
            << L"========================================\n";


        MFShutdown();
        CoUninitialize();

        return 1;
    }


    // ========================================================
    // XAUDIO2
    // ========================================================

    std::wcout
        << L"Initializing XAudio2...\n";


    hr =
        XAudio2Create(
            &g_xaudio,
            0,
            XAUDIO2_DEFAULT_PROCESSOR
        );


    if (FAILED(hr))
    {
        std::wcerr
            << L"XAudio2 initialization failed.\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        MFShutdown();
        CoUninitialize();

        return 1;
    }


    // ========================================================
    // MASTER VOICE
    // ========================================================

    hr =
        g_xaudio->CreateMasteringVoice(
            &g_masterVoice
        );


    if (FAILED(hr))
    {
        std::wcerr
            << L"Master voice creation failed.\n"
            << L"HRESULT = 0x"
            << std::hex
            << static_cast<unsigned long>(hr)
            << L"\n";

        g_xaudio.Reset();

        MFShutdown();
        CoUninitialize();

        return 1;
    }


    // ========================================================
    // VOICE POOL
    // ========================================================

    std::wcout
        << L"Creating "
        << VOICE_COUNT
        << L" voices...\n";


    if (!CreateVoicePool())
    {
        std::wcerr
            << L"Voice pool creation failed.\n";


        DestroyVoicePool();


        if (g_masterVoice)
        {
            g_masterVoice->DestroyVoice();
            g_masterVoice = nullptr;
        }


        g_xaudio.Reset();

        MFShutdown();
        CoUninitialize();

        return 1;
    }


    // ========================================================
    // WINDOW CLASS
    // ========================================================

    const wchar_t CLASS_NAME[] =
        L"KeySoundInputWindow";


    WNDCLASSW windowClass{};

    windowClass.lpfnWndProc =
        WindowProc;

    windowClass.hInstance =
        instance;

    windowClass.lpszClassName =
        CLASS_NAME;


    if (!RegisterClassW(&windowClass))
    {
        std::wcerr
            << L"RegisterClassW failed.\n";


        DestroyVoicePool();


        if (g_masterVoice)
        {
            g_masterVoice->DestroyVoice();
            g_masterVoice = nullptr;
        }


        g_xaudio.Reset();

        MFShutdown();
        CoUninitialize();

        return 1;
    }


    // ========================================================
    // MESSAGE-ONLY WINDOW
    // ========================================================

    HWND hwnd =
        CreateWindowExW(
            0,
            CLASS_NAME,
            L"KeySound",
            0,
            0,
            0,
            0,
            0,
            HWND_MESSAGE,
            nullptr,
            instance,
            nullptr
        );


    if (!hwnd)
    {
        std::wcerr
            << L"CreateWindowExW failed.\n";


        DestroyVoicePool();


        if (g_masterVoice)
        {
            g_masterVoice->DestroyVoice();
            g_masterVoice = nullptr;
        }


        g_xaudio.Reset();

        MFShutdown();
        CoUninitialize();

        return 1;
    }


    // ========================================================
    // RAW INPUT
    // ========================================================

    RAWINPUTDEVICE devices[2]{};


    // ========================================================
    // KEYBOARD
    // ========================================================

    devices[0].usUsagePage = 0x01;
    devices[0].usUsage = 0x06;

    devices[0].dwFlags =
        RIDEV_INPUTSINK;

    devices[0].hwndTarget =
        hwnd;


    // ========================================================
    // MOUSE
    // ========================================================

    devices[1].usUsagePage = 0x01;
    devices[1].usUsage = 0x02;

    devices[1].dwFlags =
        RIDEV_INPUTSINK;

    devices[1].hwndTarget =
        hwnd;


    // ========================================================
    // REGISTER BOTH
    // ========================================================

    if (
        !RegisterRawInputDevices(
            devices,
            2,
            sizeof(RAWINPUTDEVICE)
        )
        )
    {
        std::wcerr
            << L"RegisterRawInputDevices failed.\n";


        DestroyWindow(hwnd);

        DestroyVoicePool();


        if (g_masterVoice)
        {
            g_masterVoice->DestroyVoice();
            g_masterVoice = nullptr;
        }


        g_xaudio.Reset();

        MFShutdown();
        CoUninitialize();

        return 1;
    }


    // ========================================================
    // READY
    // ========================================================

    std::wcout
        << L"\n========================================\n"
        << L"                  READY\n"
        << L"========================================\n\n";

    std::wcout
        << L"Keyboard:\n"
        << L"  Any key -> Sound\n"
        << L"  Key repeat -> Ignored\n"
        << L"  ESC -> EXIT\n\n";

    std::wcout
        << L"Mouse:\n"
        << L"  Left Click   -> Sound\n"
        << L"  Right Click  -> Sound\n"
        << L"  Middle Click -> Sound\n"
        << L"  XButton 1    -> Sound\n"
        << L"  XButton 2    -> Sound\n"
        << L"  Mouse Move   -> Nothing\n"
        << L"  Wheel        -> Nothing\n\n";


    // ========================================================
    // MESSAGE LOOP
    // ========================================================

    MSG message{};

    while (
        g_running.load(
            std::memory_order_relaxed
        ) &&
        GetMessageW(
            &message,
            nullptr,
            0,
            0
        ) > 0
        )
    {
        TranslateMessage(&message);

        DispatchMessageW(&message);
    }


    // ========================================================
    // RAW INPUT 해제
    // ========================================================

    RAWINPUTDEVICE removeDevices[2]{};


    // Keyboard
    removeDevices[0].usUsagePage = 0x01;
    removeDevices[0].usUsage = 0x06;
    removeDevices[0].dwFlags = RIDEV_REMOVE;
    removeDevices[0].hwndTarget = nullptr;


    // Mouse
    removeDevices[1].usUsagePage = 0x01;
    removeDevices[1].usUsage = 0x02;
    removeDevices[1].dwFlags = RIDEV_REMOVE;
    removeDevices[1].hwndTarget = nullptr;


    RegisterRawInputDevices(
        removeDevices,
        2,
        sizeof(RAWINPUTDEVICE)
    );


    // ========================================================
    // WINDOW CLEANUP
    // ========================================================

    if (hwnd)
    {
        DestroyWindow(hwnd);
    }


    // ========================================================
    // AUDIO CLEANUP
    // ========================================================

    DestroyVoicePool();


    if (g_masterVoice)
    {
        g_masterVoice->DestroyVoice();
        g_masterVoice = nullptr;
    }


    g_xaudio.Reset();


    // ========================================================
    // MEDIA FOUNDATION
    // ========================================================

    MFShutdown();


    // ========================================================
    // COM
    // ========================================================

    CoUninitialize();


    return 0;
}
